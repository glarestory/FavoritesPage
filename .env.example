# Frontend development proxy target
API_PROXY_TARGET=http://127.0.0.1:8787

# Sync API server
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
MAX_BODY_BYTES=1048576
# Optional comma-separated origins when the API is called cross-origin.
# CORS_ORIGIN=http://127.0.0.1:5173
